{
  "rules": {
    ".read": false,
    ".write": false,

    "usernames": {
      ".read": "auth != null && (!root.child('authMeta').child(auth.uid).child('revokedBefore').exists() || auth.token.auth_time >= root.child('authMeta').child(auth.uid).child('revokedBefore').val())",
      "$customId": {
        ".write": "auth != null && (!root.child('authMeta').child(auth.uid).child('revokedBefore').exists() || auth.token.auth_time >= root.child('authMeta').child(auth.uid).child('revokedBefore').val()) && !data.exists() && newData.isString() && newData.val() === auth.uid"
      }
    },

    "loginIds": {
      "$lid": {
        ".read": "$lid.matches(/^[a-z0-9]{3,20}$/)",
        ".write": "auth != null && (!root.child('authMeta').child(auth.uid).child('revokedBefore').exists() || auth.token.auth_time >= root.child('authMeta').child(auth.uid).child('revokedBefore').val()) && ((!data.exists() && newData.child('uid').val() === auth.uid && root.child('usernames').child($lid.toUpperCase()).val() === auth.uid) || (data.exists() && data.child('uid').val() === auth.uid))",
        ".validate": "$lid.matches(/^[a-z0-9]{3,20}$/) && newData.hasChildren(['uid', 'id', 'e']) && newData.child('uid').val() === auth.uid && newData.child('id').val().toLowerCase() === $lid && newData.child('e').val() === auth.token.email && (auth.token.email_verified === true || auth.token.email.endsWith('@phonelockapp.local'))",
        "uid": { ".validate": "newData.isString()" },
        "id": { ".validate": "newData.isString()" },
        "e": { ".validate": "newData.isString()" },
        "pe": { ".validate": "newData.isString() && newData.val().length <= 254 && newData.val().contains('@')" },
        "r": { ".validate": "newData.isBoolean()" },
        "$other": { ".validate": false }
      }
    },

    "authMeta": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && (!root.child('authMeta').child(auth.uid).child('revokedBefore').exists() || auth.token.auth_time >= root.child('authMeta').child(auth.uid).child('revokedBefore').val())",
        ".write": "auth != null && auth.uid === $uid && (!root.child('authMeta').child(auth.uid).child('revokedBefore').exists() || auth.token.auth_time >= root.child('authMeta').child(auth.uid).child('revokedBefore').val()) && now / 1000 - auth.token.auth_time <= 300 && !newData.exists()",

        "revokedBefore": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && (!root.child('authMeta').child(auth.uid).child('revokedBefore').exists() || auth.token.auth_time >= root.child('authMeta').child(auth.uid).child('revokedBefore').val()) && now / 1000 - auth.token.auth_time <= 300",
          ".validate": "newData.isNumber() && newData.val() <= now / 1000 + 60 && (!data.exists() || newData.val() >= data.val())"
        },

        "sessions": {
          "$sid": {
            ".write": "auth != null && auth.uid === $uid && (!root.child('authMeta').child(auth.uid).child('revokedBefore').exists() || auth.token.auth_time >= root.child('authMeta').child(auth.uid).child('revokedBefore').val()) && $sid.matches(/^[A-Za-z0-9_-]{8,64}$/)",
            ".validate": "newData.hasChildren(['p', 'at', 'seen']) && newData.child('at').val() === auth.token.auth_time && newData.child('seen').val() === now",
            "p": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "n": { ".validate": "newData.isString() && newData.val().length <= 80" },
            "m": { ".validate": "newData.isString() && newData.val().length <= 10" },
            "v": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "at": { ".validate": "newData.isNumber()" },
            "seen": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "events": {
          ".indexOn": ["at"],
          "$eid": {
            ".write": "auth != null && auth.uid === $uid && (!root.child('authMeta').child(auth.uid).child('revokedBefore').exists() || auth.token.auth_time >= root.child('authMeta').child(auth.uid).child('revokedBefore').val()) && ((!data.exists() && newData.exists()) || (data.exists() && !newData.exists() && data.child('at').val() < now - 7776000000))",
            ".validate": "newData.hasChildren(['t', 'at']) && newData.child('at').val() === now",
            "t": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "m": { ".validate": "newData.isString() && newData.val().length <= 10" },
            "p": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "n": { ".validate": "newData.isString() && newData.val().length <= 80" },
            "at": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "identities": {
          "google": {
            ".write": "auth != null && auth.uid === $uid && (!root.child('authMeta').child(auth.uid).child('revokedBefore').exists() || auth.token.auth_time >= root.child('authMeta').child(auth.uid).child('revokedBefore').val()) && (now / 1000 - auth.token.auth_time <= 900 || auth.token.firebase.sign_in_provider === 'anonymous')",
            ".validate": "newData.hasChildren(['sub', 'at']) && newData.child('at').val() === now",
            "sub": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "email": { ".validate": "newData.isString() && newData.val().length <= 254" },
            "at": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        }
      }
    },

    "allowedUsers": {
      ".read": false,
      "$uid": {
        ".write": "auth != null && (!root.child('authMeta').child(auth.uid).child('revokedBefore').exists() || auth.token.auth_time >= root.child('authMeta').child(auth.uid).child('revokedBefore').val()) && root.child('usernames').child('BEULTAEON').val() === auth.uid"
      }
    },

    "users": {
      ".read": "auth != null && (!root.child('authMeta').child(auth.uid).child('revokedBefore').exists() || auth.token.auth_time >= root.child('authMeta').child(auth.uid).child('revokedBefore').val()) && root.child('usernames').child('BEULTAEON').val() === auth.uid",
      "$uid": {
        ".read": "auth != null && (!root.child('authMeta').child(auth.uid).child('revokedBefore').exists() || auth.token.auth_time >= root.child('authMeta').child(auth.uid).child('revokedBefore').val()) && auth.uid === $uid && root.child('allowedUsers').child(auth.uid).exists()",
        ".write": "auth != null && (!root.child('authMeta').child(auth.uid).child('revokedBefore').exists() || auth.token.auth_time >= root.child('authMeta').child(auth.uid).child('revokedBefore').val()) && auth.uid === $uid && root.child('allowedUsers').child(auth.uid).exists()",

        "profile": {
          ".read": "auth != null && (!root.child('authMeta').child(auth.uid).child('revokedBefore').exists() || auth.token.auth_time >= root.child('authMeta').child(auth.uid).child('revokedBefore').val()) && (auth.uid === $uid || root.child('usernames').child('BEULTAEON').val() === auth.uid)",
          ".write": "auth != null && (!root.child('authMeta').child(auth.uid).child('revokedBefore').exists() || auth.token.auth_time >= root.child('authMeta').child(auth.uid).child('revokedBefore').val()) && ((auth.uid === $uid && newData.child('status').val() !== 'approved') || root.child('usernames').child('BEULTAEON').val() === auth.uid)"
        },

        "socialGroupIds": {
          "$groupId": {
            ".write": "auth != null && (!root.child('authMeta').child(auth.uid).child('revokedBefore').exists() || auth.token.auth_time >= root.child('authMeta').child(auth.uid).child('revokedBefore').val()) && root.child('allowedUsers').child(auth.uid).exists() && (auth.uid === $uid || root.child('groups').child($groupId).child('info').child('ownerUid').val() === auth.uid || root.child('groups').child($groupId).child('admins').child(auth.uid).val() === true)"
          }
        },

        "dmChatIds": {
          "$chatId": {
            ".write": "auth != null && (!root.child('authMeta').child(auth.uid).child('revokedBefore').exists() || auth.token.auth_time >= root.child('authMeta').child(auth.uid).child('revokedBefore').val()) && root.child('allowedUsers').child(auth.uid).exists() && (auth.uid === $uid || root.child('dmChats').child($chatId).child('info').child('participants').child(auth.uid).exists())"
          }
        }
      }
    },

    "groups": {
      "$groupId": {
        ".read": "auth != null && (!root.child('authMeta').child(auth.uid).child('revokedBefore').exists() || auth.token.auth_time >= root.child('authMeta').child(auth.uid).child('revokedBefore').val()) && root.child('allowedUsers').child(auth.uid).exists() && data.child('members').child(auth.uid).exists()",
        ".write": "auth != null && (!root.child('authMeta').child(auth.uid).child('revokedBefore').exists() || auth.token.auth_time >= root.child('authMeta').child(auth.uid).child('revokedBefore').val()) && root.child('allowedUsers').child(auth.uid).exists() && ((!data.exists() && newData.child('info').child('ownerUid').val() === auth.uid) || (data.exists() && data.child('info').child('ownerUid').val() === auth.uid))",

        "info": {
          ".write": "auth != null && (!root.child('authMeta').child(auth.uid).child('revokedBefore').exists() || auth.token.auth_time >= root.child('authMeta').child(auth.uid).child('revokedBefore').val()) && root.child('allowedUsers').child(auth.uid).exists() && (data.child('ownerUid').val() === auth.uid || root.child('groups').child($groupId).child('admins').child(auth.uid).val() === true)"
        },

        "members": {
          "$memberUid": {
            ".write": "auth != null && (!root.child('authMeta').child(auth.uid).child('revokedBefore').exists() || auth.token.auth_time >= root.child('authMeta').child(auth.uid).child('revokedBefore').val()) && root.child('allowedUsers').child(auth.uid).exists() && (auth.uid === $memberUid || root.child('groups').child($groupId).child('info').child('ownerUid').val() === auth.uid || root.child('groups').child($groupId).child('admins').child(auth.uid).val() === true)"
          }
        },

        "stats": {
          "$statUid": {
            ".write": "auth != null && (!root.child('authMeta').child(auth.uid).child('revokedBefore').exists() || auth.token.auth_time >= root.child('authMeta').child(auth.uid).child('revokedBefore').val()) && root.child('allowedUsers').child(auth.uid).exists() && auth.uid === $statUid"
          }
        },

        "nudges": {
          "$targetUid": {
            ".write": "auth != null && (!root.child('authMeta').child(auth.uid).child('revokedBefore').exists() || auth.token.auth_time >= root.child('authMeta').child(auth.uid).child('revokedBefore').val()) && root.child('allowedUsers').child(auth.uid).exists() && root.child('groups').child($groupId).child('members').child(auth.uid).exists()"
          }
        },

        "voiceMessages": {
          "$targetUid": {
            "$msgId": {
              ".write": "auth != null && (!root.child('authMeta').child(auth.uid).child('revokedBefore').exists() || auth.token.auth_time >= root.child('authMeta').child(auth.uid).child('revokedBefore').val()) && root.child('allowedUsers').child(auth.uid).exists() && root.child('groups').child($groupId).child('members').child(auth.uid).exists()"
            }
          }
        },

        "walkieSettings": {
          "$uid": {
            ".write": "auth != null && (!root.child('authMeta').child(auth.uid).child('revokedBefore').exists() || auth.token.auth_time >= root.child('authMeta').child(auth.uid).child('revokedBefore').val()) && root.child('allowedUsers').child(auth.uid).exists() && auth.uid === $uid"
          }
        },

        "announcement": {
          ".write": "auth != null && (!root.child('authMeta').child(auth.uid).child('revokedBefore').exists() || auth.token.auth_time >= root.child('authMeta').child(auth.uid).child('revokedBefore').val()) && root.child('allowedUsers').child(auth.uid).exists() && (root.child('groups').child($groupId).child('info').child('ownerUid').val() === auth.uid || root.child('groups').child($groupId).child('admins').child(auth.uid).val() === true)"
        },

        "goal": {
          ".write": "auth != null && (!root.child('authMeta').child(auth.uid).child('revokedBefore').exists() || auth.token.auth_time >= root.child('authMeta').child(auth.uid).child('revokedBefore').val()) && root.child('allowedUsers').child(auth.uid).exists() && (root.child('groups').child($groupId).child('info').child('ownerUid').val() === auth.uid || root.child('groups').child($groupId).child('admins').child(auth.uid).val() === true)"
        },

        "quoteStats": {
          "$uid": {
            ".write": "auth != null && (!root.child('authMeta').child(auth.uid).child('revokedBefore').exists() || auth.token.auth_time >= root.child('authMeta').child(auth.uid).child('revokedBefore').val()) && root.child('allowedUsers').child(auth.uid).exists() && auth.uid === $uid"
          }
        }
      }
    },

    "groupChats": {
      "$groupId": {
        ".read": "auth != null && (!root.child('authMeta').child(auth.uid).child('revokedBefore').exists() || auth.token.auth_time >= root.child('authMeta').child(auth.uid).child('revokedBefore').val()) && root.child('allowedUsers').child(auth.uid).exists() && root.child('groups').child($groupId).child('members').child(auth.uid).exists()",

        "messages": {
          ".indexOn": ["sentAtMillis"],
          "$msgId": {
            ".write": "auth != null && (!root.child('authMeta').child(auth.uid).child('revokedBefore').exists() || auth.token.auth_time >= root.child('authMeta').child(auth.uid).child('revokedBefore').val()) && root.child('allowedUsers').child(auth.uid).exists() && root.child('groups').child($groupId).child('members').child(auth.uid).exists() && (data.exists() ? data.child('senderUid').val() === auth.uid : newData.child('senderUid').val() === auth.uid)",

            "reactions": {
              "$uid": {
                ".write": "auth != null && (!root.child('authMeta').child(auth.uid).child('revokedBefore').exists() || auth.token.auth_time >= root.child('authMeta').child(auth.uid).child('revokedBefore').val()) && root.child('allowedUsers').child(auth.uid).exists() && root.child('groups').child($groupId).child('members').child(auth.uid).exists() && auth.uid === $uid"
              }
            }
          }
        }
      }
    },

    "dmChats": {
      "$chatId": {
        ".read": "auth != null && (!root.child('authMeta').child(auth.uid).child('revokedBefore').exists() || auth.token.auth_time >= root.child('authMeta').child(auth.uid).child('revokedBefore').val()) && root.child('allowedUsers').child(auth.uid).exists() && data.child('info').child('participants').child(auth.uid).exists()",

        "info": {
          ".write": "auth != null && (!root.child('authMeta').child(auth.uid).child('revokedBefore').exists() || auth.token.auth_time >= root.child('authMeta').child(auth.uid).child('revokedBefore').val()) && root.child('allowedUsers').child(auth.uid).exists() && !data.exists() && newData.child('participants').child(auth.uid).exists()"
        },

        "messages": {
          ".indexOn": ["sentAtMillis"],
          "$msgId": {
            ".write": "auth != null && (!root.child('authMeta').child(auth.uid).child('revokedBefore').exists() || auth.token.auth_time >= root.child('authMeta').child(auth.uid).child('revokedBefore').val()) && root.child('allowedUsers').child(auth.uid).exists() && root.child('dmChats').child($chatId).child('info').child('participants').child(auth.uid).exists() && (data.exists() ? data.child('senderUid').val() === auth.uid : newData.child('senderUid').val() === auth.uid)",

            "reactions": {
              "$uid": {
                ".write": "auth != null && (!root.child('authMeta').child(auth.uid).child('revokedBefore').exists() || auth.token.auth_time >= root.child('authMeta').child(auth.uid).child('revokedBefore').val()) && root.child('allowedUsers').child(auth.uid).exists() && root.child('dmChats').child($chatId).child('info').child('participants').child(auth.uid).exists() && auth.uid === $uid"
              }
            }
          }
        }
      }
    },

    "inviteCodes": {
      "$code": {
        ".read": "auth != null && (!root.child('authMeta').child(auth.uid).child('revokedBefore').exists() || auth.token.auth_time >= root.child('authMeta').child(auth.uid).child('revokedBefore').val()) && root.child('allowedUsers').child(auth.uid).exists()",
        ".write": "auth != null && (!root.child('authMeta').child(auth.uid).child('revokedBefore').exists() || auth.token.auth_time >= root.child('authMeta').child(auth.uid).child('revokedBefore').val()) && root.child('allowedUsers').child(auth.uid).exists()"
      }
    },

    "backups": {
      "$uid": {
        ".read": "auth != null && (!root.child('authMeta').child(auth.uid).child('revokedBefore').exists() || auth.token.auth_time >= root.child('authMeta').child(auth.uid).child('revokedBefore').val()) && auth.uid === $uid && root.child('allowedUsers').child(auth.uid).exists()",
        ".write": "auth != null && (!root.child('authMeta').child(auth.uid).child('revokedBefore').exists() || auth.token.auth_time >= root.child('authMeta').child(auth.uid).child('revokedBefore').val()) && auth.uid === $uid && root.child('allowedUsers').child(auth.uid).exists()"
      }
    }
  }
}
