<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 146차: 홈 컨셉이 식물에서 우주로 바뀌면서 새싹 대신 "우주 속의 별"(사용자 요청). 네 갈래 별 + 기울어진 궤도 고리 +
         작은 점별 — 모두 안전영역(지름 66, x/y 21~87) 안. 고리는 별 뒤로 지나가는 윗호(어둡게)와 앞으로 지나가는
         아랫호(강조색)로 나눠 입체감을 낸다. 데스크탑 ui/SunriseIcon.kt가 같은 좌표·같은 색을 그린다. -->

    <!-- 별 뒤의 은은한 빛 -->
    <path android:pathData="M24,54 a30,30 0 1,0 60,0 a30,30 0 1,0 -60,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54" android:centerY="54"
                android:gradientRadius="30"
                android:startColor="#556AA4FF"
                android:endColor="#006AA4FF" />
        </aapt:attr>
    </path>

    <!-- 궤도 고리: 별 뒤로 지나가는 윗호 -->
    <path
        android:strokeColor="#3A5C95"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:pathData="M24.77,67.02 A32,10.5 -24 0,1 83.23,40.98" />

    <!-- 작은 점별 -->
    <path
        android:fillColor="#C9D6F2"
        android:pathData="M31.1,34 a1.9,1.9 0 1,0 3.8,0 a1.9,1.9 0 1,0 -3.8,0 Z M75.7,31 a1.3,1.3 0 1,0 2.6,0 a1.3,1.3 0 1,0 -2.6,0 Z M71.9,76 a2.1,2.1 0 1,0 4.2,0 a2.1,2.1 0 1,0 -4.2,0 Z M29.8,74 a1.2,1.2 0 1,0 2.4,0 a1.2,1.2 0 1,0 -2.4,0 Z M83,52 a1,1 0 1,0 2,0 a1,1 0 1,0 -2,0 Z M45.1,84 a0.9,0.9 0 1,0 1.8,0 a0.9,0.9 0 1,0 -1.8,0 Z" />

    <!-- 네 갈래 별 -->
    <path
        android:fillColor="#F4F7FF"
        android:pathData="M54,29 Q58,50 79,54 Q58,58 54,79 Q50,58 29,54 Q50,50 54,29 Z" />

    <!-- 궤도 고리: 별 앞으로 지나가는 아랫호 -->
    <path
        android:strokeColor="#6AA4FF"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:pathData="M83.23,40.98 A32,10.5 -24 0,1 24.77,67.02" />
</vector>
