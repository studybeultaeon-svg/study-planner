<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 새싹 컨셉(119차)에 맞춰 하늘색→연두색 그라데이션으로 변경. 배경 레이어는 런처 마스킹으로
         가장자리가 잘려도 괜찮은 단순 색면이라 안전영역 제약이 없다. -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="0"
                android:endX="54" android:endY="108"
                android:startColor="#A5D6E8"
                android:centerColor="#DCEDC8"
                android:centerY="0.5"
                android:endColor="#C5E1A5" />
        </aapt:attr>
    </path>
</vector>
